CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth: BLE only (Bluedroid), needed by ESP-BLE-MESH
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BTU_TASK_STACK_SIZE=4512

# ESP-BLE-MESH: plain node, keys persisted in NVS
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PB_ADV=y
CONFIG_BLE_MESH_PB_GATT=n
CONFIG_BLE_MESH_GATT_PROXY_SERVER=n
CONFIG_BLE_MESH_RELAY=n
CONFIG_BLE_MESH_SETTINGS=y
# Persist SEQ every 64 messages (not every message) to spare flash; on boot
# the stack rounds SEQ up to the next multiple, so it never goes backwards.
CONFIG_BLE_MESH_SEQ_STORE_RATE=64
CONFIG_BLE_MESH_USE_DUPLICATE_SCAN=y
CONFIG_BLE_MESH_MODEL_GROUP_COUNT=24
CONFIG_BLE_MESH_CRPL=20
CONFIG_BLE_MESH_GENERIC_ONOFF_CLI=y
CONFIG_BLE_MESH_GENERIC_PROPERTY_CLI=y
CONFIG_BLE_MESH_LIGHT_LIGHTNESS_CLI=y

# Firmware update over Wi-Fi from a LAN http:// URL
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
# A new image that never confirms itself (see ota_check_pending) rolls back.
# Lives in the bootloader, so changing it needs a USB flash.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Wi-Fi + BLE share the radio
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
